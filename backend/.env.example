# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/novamart

# JWT Security
JWT_SECRET=super_secret_novamart_jwt_key_phase2_min32chars
JWT_EXPIRES_IN=7d

# Client URL (CORS & Cookie)
CLIENT_URL=http://localhost:5173

# Default Admin Seeding Credentials (scripts/seedAdmin.js)
ADMIN_NAME=Admin Manager
ADMIN_EMAIL=admin@novamart.com
ADMIN_PASSWORD=AdminPassword123!
